<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ApplicationDataTypes</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-PRIMITIVE-DATA-TYPE>
          <SHORT-NAME>Uint16</SHORT-NAME>
          <CATEGORY>VALUE</CATEGORY>
        </APPLICATION-PRIMITIVE-DATA-TYPE>
        <APPLICATION-RECORD-DATA-TYPE>
          <SHORT-NAME>RecFoo</SHORT-NAME>
          <CATEGORY>STRUCTURE</CATEGORY>
          <ELEMENTS>
            <APPLICATION-RECORD-ELEMENT>
              <SHORT-NAME>a</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ApplicationDataTypes/Uint16</TYPE-TREF>
            </APPLICATION-RECORD-ELEMENT>
            <APPLICATION-RECORD-ELEMENT>
              <SHORT-NAME>b</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ApplicationDataTypes/Uint16</TYPE-TREF>
            </APPLICATION-RECORD-ELEMENT>
          </ELEMENTS>
        </APPLICATION-RECORD-DATA-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>ConstantSpecifications</SHORT-NAME>
      <ELEMENTS>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>CS_HasValue</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <SHORT-LABEL>Uint16</SHORT-LABEL>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/Units/NoUnit</UNIT-REF>
                <SW-VALUES-PHYS>
                  <V>1</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>CS_EmptyPrim</SHORT-NAME>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>CS_RecFoo</SHORT-NAME>
        </CONSTANT-SPECIFICATION>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>SwComponentType</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>DummySwc</SHORT-NAME>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>DummySwc_IB</SHORT-NAME>
              <SHARED-PARAMETERS>
                <PARAMETER-DATA-PROTOTYPE>
                  <SHORT-NAME>P_EmptyPrim</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/ApplicationDataTypes/Uint16</TYPE-TREF>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/ConstantSpecifications/CS_EmptyPrim</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
                  </INIT-VALUE>
                </PARAMETER-DATA-PROTOTYPE>
                <PARAMETER-DATA-PROTOTYPE>
                  <SHORT-NAME>P_RecFoo</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/ApplicationDataTypes/RecFoo</TYPE-TREF>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/ConstantSpecifications/CS_RecFoo</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
                  </INIT-VALUE>
                </PARAMETER-DATA-PROTOTYPE>
              </SHARED-PARAMETERS>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
